    "input_format": "Question: {question}\nChoices:\n{choices}\n",
    "target_field": "answer",
    "choices_separator": "\n",
    "postprocessors": [
        "processors.extract_multiple_choice_answer",
        "processors.first_character",
        "processors.lower_case"
    ]
}
